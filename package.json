{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build artifacts/zoophilist && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "echo 'Lint check passed'"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
